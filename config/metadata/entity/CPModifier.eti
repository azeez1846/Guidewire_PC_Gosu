<?xml version="1.0" encoding="UTF-8"?>
<entity xmlns="http://guidewire.com/datamodel" entity="CPModifier" table="cp_modifier" type="retireable" desc="Commercial Property rating modifier (Protection Class modifier, Age modifier).">
  <column name="ModifierCode" type="shorttext" nullok="false" desc="CP_PROTECTION_MOD, CP_AGE_MOD, CP_SPRINKLER_MOD"/>
  <column name="ModifierValue" type="decimal" precision="6" scale="3" nullok="false" desc="Modifier value e.g. 0.850"/>
  <column name="Justification" type="shorttext" nullok="true" desc="Underwriter notes"/>
</entity>

<?xml version="1.0" encoding="UTF-8"?>
<entity xmlns="http://guidewire.com/datamodel" entity="CommercialUmbrellaLine" table="comm_umb_line" type="effdated" desc="Commercial Umbrella policy line tracking umbrella aggregate limit, SIR amount, and umbrella line premium.">
  <column name="LineCode" type="shorttext" nullok="false" desc="Line Code e.g. CommercialUmbrellaLine"/>
  <column name="EachOccurrenceLimit" type="shorttext" nullok="false" desc="Limit per occurrence e.g. $1,000,000, $5,000,000, $10,000,000"/>
  <column name="AggregateLimit" type="shorttext" nullok="false" desc="Umbrella General Aggregate limit e.g. $5,000,000, $10,000,000"/>
  <column name="SelfInsuredRetention" type="decimal" precision="12" scale="2" nullok="false" desc="Self-Insured Retention (SIR) amount e.g. 10000.00"/>
  <column name="TotalLinePremium" type="decimal" precision="12" scale="2" nullok="false" desc="Total Commercial Umbrella line premium"/>
</entity>

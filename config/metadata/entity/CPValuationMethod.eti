<?xml version="1.0" encoding="UTF-8"?>
<entity xmlns="http://guidewire.com/datamodel" entity="CPValuationMethod" table="cp_valuation" type="retireable" desc="Property valuation method rules (Replacement Cost, ACV, Functional Replacement Cost).">
  <column name="ValuationType" type="shorttext" nullok="false" desc="ReplacementCost, ActualCashValue, FunctionalRC"/>
  <column name="InflationGuardPercent" type="decimal" precision="5" scale="2" nullok="true" desc="Annual inflation guard percentage e.g. 4.00, 8.00"/>
</entity>

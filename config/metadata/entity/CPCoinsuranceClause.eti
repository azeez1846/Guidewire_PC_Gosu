<?xml version="1.0" encoding="UTF-8"?>
<entity xmlns="http://guidewire.com/datamodel" entity="CPCoinsuranceClause" table="cp_coinsurance" type="retireable" desc="Property coinsurance clause parameters and penalty rules.">
  <column name="RequiredPercentage" type="integer" nullok="false" desc="Required percentage e.g. 80, 90, 100"/>
  <column name="WaivedForSmallLosses" type="bit" nullok="false" desc="True if coinsurance is waived for losses under $10,000"/>
</entity>

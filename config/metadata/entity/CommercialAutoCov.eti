  <column name="MedicalPaymentsLimit" type="shorttext" nullok="true" desc="Auto MedPay limit e.g. $5,000, $10,000"/>
  <column name="HiredAutoLiability" type="bit" nullok="false" desc="Hired Auto Liability inclusion flag"/>
  <column name="NonOwnedAutoLiability" type="bit" nullok="false" desc="Non-Owned Auto Liability inclusion flag"/>
</entity>

<?xml version="1.0" encoding="UTF-8"?>
<product id="CommercialAuto" name="Commercial Auto">
  <line id="CommercialAutoLine" name="Commercial Auto Line">
    <coverage-pattern code="CAAutoLiabilityCov" name="Commercial Auto Liability" category="Liability">
      <limit default="1000000">
        <option value="500000" display="$500k/$500k"/>
        <option value="1000000" display="$1M/$1M"/>
      </limit>
    </coverage-pattern>
    <coverage-pattern code="CACollisionCov" name="Commercial Collision" category="PhysicalDamage">
      <deductible default="1000">
        <option value="500" display="$500"/>
        <option value="1000" display="$1000"/>
      </deductible>
    </coverage-pattern>
  </line>
</product>
